{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TrueForge Extension (Flask Workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "D:\\flask"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}

