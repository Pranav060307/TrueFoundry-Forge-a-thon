{
  "name": "trueforge-coding-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code coding agent workspace powered by TrueFoundry TrueForge runtime",
  "scripts": {
    "build:webview": "npm --prefix webview run build",
    "build:extension": "npm --prefix extension run build",
    "build": "npm run build:webview && npm run build:extension",
    "dev": "code --extensionDevelopmentPath=./extension",
    "start:sidecar": "python backend/main.py --port 4545",
    "start:trueforge": "npx @truefoundry/trueforge@latest --port 8790",
    "test": "node tests/run_tests.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
